# Copy to .env (compose reads it). Every value is optional; these are the defaults from plan §2.
# There are no secrets here: the owner password is set with `python -m app.cli create-owner`.
LFT_MAX_QUEUED=5
LFT_MAX_UPLOAD_MB=50
LFT_MAX_FILES=30
LFT_JOB_TIMEOUT_SECONDS=300
LFT_DISK_BUDGET_MB=2048
LFT_RETENTION_SECONDS=3600
LFT_CLEANUP_INTERVAL_SECONDS=300
