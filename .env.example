# Copy to .env (compose reads it). Every value is optional; these are the defaults.
# There are no secrets here.
LFT_MAX_QUEUED=20
LFT_MAX_UPLOAD_MB=50
LFT_MAX_FILES=30
LFT_MAX_IMAGE_MP=60
LFT_MAX_PDF_PAGES=100
LFT_JOB_TIMEOUT_SECONDS=300
LFT_DISK_BUDGET_MB=2048
LFT_RETENTION_SECONDS=900
LFT_CLEANUP_INTERVAL_SECONDS=60
# Optional: "host:port" of the server on your LAN, e.g. 192.168.1.10:8080, to use the site over plain HTTP there.
# Empty means the site works over HTTPS only. See docs/deploy.md, case C.
LFT_LAN_HOST=
