# Copy to .env (compose reads it). Every value is optional; these are the defaults from plan §2.
# There are no secrets here: the owner password is set with `python -m app.cli create-owner`.
LFT_MAX_QUEUED=5
LFT_MAX_UPLOAD_MB=50
LFT_MAX_FILES=30
LFT_MAX_IMAGE_MP=60
LFT_MAX_PDF_PAGES=100
LFT_JOB_TIMEOUT_SECONDS=300
LFT_DISK_BUDGET_MB=2048
LFT_RETENTION_SECONDS=3600
LFT_CLEANUP_INTERVAL_SECONDS=300
# Optional: "host:port" of the server on your LAN, e.g. 192.168.1.10:8080, to log in there over plain HTTP.
# Empty means login works over HTTPS only. See docs/deploy.md, case C.
LFT_LAN_HOST=
# Optional: addresses or networks the tunnel's requests come from, comma-separated, e.g. 172.16.0.0/12.
# When set, the visitor address reported by Cloudflare is believed only on those connections. Set it whenever
# anything other than cloudflared can reach the web port (docs/deploy.md, cases B and C).
LFT_PROXY_IPS=
